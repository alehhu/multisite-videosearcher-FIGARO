# Copy to site.env (not tracked) on each server and fill in. Read by scripts/setup-site.sh.

# Which site this server is: edge or cloud.
SITE="edge"

# Address (host:port) of the OTHER site's broker, on exactly ONE of the two sites: the one
# that can reach the other. Leave empty on the other site, and when running a single site.
# Through the SSH tunnel of scripts/tunnel.sh, on the edge: 10.42.0.1:41883
BRIDGE_TO=""
