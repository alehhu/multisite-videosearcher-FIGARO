# Settings of this server, read by scripts/setup-site.sh.
#
# Edit this file on each server after cloning, then run scripts/setup-site.sh.
# Run it again after every change here. Keep the edited copy local: do not commit it.
#
# The values below set up a single site with fixed replicas, enough for a first test:
#   scripts/setup-site.sh
#   .venv/bin/python scripts/placement.py publish placements/all-edge.yaml --broker localhost:31883

# Which site this server is.
#   edge   the site the clients talk to: it also runs the gateway and the timing collector.
#   cloud  the other site: broker, controller and stages only.
# With a single server use edge.
SITE="edge"

# Address (host:port) of the OTHER site's broker, to open the MQTT bridge that carries
# jobs, placement and status between the two sites.
# Set it on exactly ONE of the two sites, the one that can reach the other, and leave it
# empty on the other site and when there is a single site.
#   through the SSH tunnel of scripts/tunnel.sh, on the edge:   BRIDGE_TO="10.42.0.1:41883"
#   with a direct route to the other server:                    BRIDGE_TO="<other-host>:31883"
BRIDGE_TO=""

# How the stages are scaled.
#   false  every stage keeps a fixed number of replicas (`replicas` in
#          deploy/k8s/base/controller-config.yaml).
#   true   each stage is scaled by its DQN agent: six more pods on this site, and a large
#          image to build the first time. Use the same value on both sites.
AGENTS="false"
